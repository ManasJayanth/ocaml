{
  "esy": {
    "build": [
      "ocamlc -version",
      "ocamlopt -version",
      "ocamlc -I +unix -o smoke.byte unix.cma smoke.ml",
      "ocamlrun ./smoke.byte",
      "ocamlopt -I +unix -o smoke.exe unix.cmxa smoke.ml",
      "./smoke.exe"
    ]
  },
  "dependencies": {
    "ocaml": "5.5.1000"
  },
  "resolutions": {
    "ocaml": "5.5.1000"
  }
}
